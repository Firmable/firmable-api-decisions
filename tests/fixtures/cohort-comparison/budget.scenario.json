                      "fp000463941370"
                    ],
                    "title": "Person Id"
                  },
                  "linkedin_url": {
                    "anyOf": [
                      {
                        "maxLength": 300,
                        "pattern": "(?i)linkedin\\.com/in/([^/?#\\s]+)",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Their LinkedIn profile URL, e.g. https://www.linkedin.com/in/jane-doe",
                    "title": "Linkedin Url"
                  },
                  "work_email": {
                    "anyOf": [
                      {
                        "maxLength": 254,
                        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Their work email. Used to find them only; never stored or echoed",
                    "title": "Work Email"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 2,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Optional: the person's name as you hold it; a mismatch gives unknown",
                    "title": "Name"
                  },
                  "company": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 2,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Optional: their employer as you hold it; a mismatch gives unknown",
                    "title": "Company"
                  },
                  "within_months": {
