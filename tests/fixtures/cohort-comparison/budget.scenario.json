            {
              "name": "is_b2b",
              "summary": "Does this company sell to businesses or government, even if it also sells to consumers? Details say businesses, consumers or both. Use to screen out consumer businesses. For a specific product or service, use `offers_service`.",
              "subject": "company",
              "uses_decision_model": true,
              "input_schema": {
                "additionalProperties": false,
                "properties": {
                  "external_id": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Your own ID for this row, echoed back",
                    "title": "External Id"
                  },
                  "company_id": {
                    "anyOf": [
                      {
                        "pattern": "^f\\d{12}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Firmable company ID; or give domain",
                    "examples": [
                      "f000002437529"
                    ],
                    "title": "Company Id"
                  },
                  "domain": {
                    "anyOf": [
                      {
                        "maxLength": 300,
                        "minLength": 4,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The company's domain or website, e.g. linfox.com. Personal mail and parked domains never match",
                    "title": "Domain"
                  }
                },
                "title": "Input",
                "type": "object"
              },
              "details": [
                "sells_to"
              ],
              "example": {
                "company_id": "f900000000001"
              }
            },
            {
              "name": "matches_company_size",
              "summary": "Is this company's staff count inside the range you give (`min_staff`, `max_staff`), worldwide or, with `staff_in`, in one of the 13 markets? Unknown where Firmable doesn't hold the count for that country. Use for a size check alone. For a full fit check with other criteria, use `is_icp_fit`.",
              "subject": "company",
              "uses_decision_model": false,
              "input_schema": {
                "additionalProperties": false,
                "properties": {
                  "external_id": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
