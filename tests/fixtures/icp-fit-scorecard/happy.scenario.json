     "version": "v1",
     "tools": [
      {
       "name": "is_icp_fit",
       "summary": "Does this company fit your ideal customer profile? Checks `icp` filters (staff, industry, country, revenue; `staff_in` any of the 13 markets), then judges up to 10 `criteria`, not a description. A criterion the record can't show is left out; if the rest are met, yes, and the reason names the gap. For a campaign, use `matches_campaign_audience`; for one question, `evaluate_custom_decision`. Write criteria as checkable facts: a criterion that asks for a judgement (reputation, leading, trusted) can be met from the company's own description.",
       "subject": "company",
       "uses_decision_model": true,
       "input_schema": {
        "$defs": {
         "ICP": {
          "properties": {
           "min_staff": {
            "anyOf": [
             {
              "minimum": 0,
              "type": "integer"
             },
             {
              "type": "null"
             }
            ],
            "default": null,
            "description": "Fewest staff, worldwide unless `staff_in` names a country",
            "title": "Min Staff"
           },
           "max_staff": {
            "anyOf": [
             {
              "minimum": 0,
              "type": "integer"
             },
             {
              "type": "null"
             }
            ],
            "default": null,
            "description": "Most staff, worldwide unless `staff_in` names a country",
            "title": "Max Staff"
           },
           "staff_in": {
            "anyOf": [
             {
              "enum": [
               "AU",
               "NZ",
               "SG",
               "MY",
               "ID",
               "PH",
               "HK",
               "JP",
               "VN",
               "KR",
               "TH",
               "US",
               "CA"
              ],
              "type": "string"
             },
             {
              "type": "null"
             }
            ],
            "default": null,
            "description": "Count staff in this country only, e.g. AU. Leave out to count staff worldwide",
            "title": "Staff In"
           },
           "industries": {
            "description": "Industry names or ANZSIC code prefixes; any one matches",
            "items": {
             "type": "string"
            },
            "title": "Industries",
            "type": "array"
           },
           "countries": {
            "description": "HQ countries, ISO codes; any one matches",
            "items": {
             "type": "string"
            },
            "title": "Countries",
            "type": "array"
           },
           "revenue_bands": {
            "description": "Revenue bands as Firmable writes them: <$1M, $1M - $5M, $5M - $10M, $10M - $50M, $50M - $100M, $100M - $250M, $250M - $500M, $500M - $1B, >$1B+",
            "items": {
             "type": "string"
            },
            "title": "Revenue Bands",
            "type": "array"
           },
           "description": {
            "anyOf": [
             {
              "type": "string"
             },
             {
              "type": "null"
             }
            ],
            "default": null,
            "description": "Not accepted in the first cut: give `criteria` instead. A description is judged as one score, so doubt about one part pulls down the parts that are certain",
            "title": "Description"
           },
           "criteria": {
            "description": "The ICP as up to 10 separate criteria, 2,000 characters in all, each judged on its own, e.g. ['Sells to other businesses', 'Has a sales team']",
            "items": {
             "minLength": 2,
             "type": "string"
            },
            "maxItems": 10,
            "title": "Criteria",
            "type": "array"
           }
          },
          "title": "ICP",
          "type": "object"
         }
        },
        "additionalProperties": false,
        "properties": {
         "external_id": {
          "anyOf": [
           {
            "maxLength": 200,
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "default": null,
          "description": "Your own ID for this row, echoed back",
          "title": "External Id"
         },
         "company_id": {
          "anyOf": [
           {
            "pattern": "^f\\d{12}$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "default": null,
          "description": "Firmable company ID; or give domain",
          "examples": [
           "f000002437529"
          ],
          "title": "Company Id"
         },
         "domain": {
          "anyOf": [
           {
            "maxLength": 300,
            "minLength": 4,
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "default": null,
          "description": "The company's domain or website, e.g. linfox.com. Personal mail and parked domains never match",
          "title": "Domain"
         },
         "icp": {
          "$ref": "#/$defs/ICP"
         }
        },
        "required": [
         "icp"
        ],
        "title": "Input",
        "type": "object"
       },
       "details": [
        "criteria",
        "filters"
       ],
       "example": {
